# Copy these values into a manually created Render Environment Group named
# jobradar-hosted. Never commit the populated file. See docs/deploy_hosted.md.
APP_ENV=production
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?ssl=require
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=3
DB_POOL_TIMEOUT=30
REDIS_URL=rediss://default:PASSWORD@REDIS_HOST:6379/0?ssl_cert_reqs=required
REDIS_SOCKET_TIMEOUT=5
CELERY_BROKER_POOL_LIMIT=2
CELERY_RESULT_EXPIRES=3600
JWT_SECRET_KEY=
ADMIN_API_KEY=
CV_ENCRYPTION_KEY=
PROXY_SHARED_SECRET=
CORS_ORIGINS=https://YOUR_PROJECT.vercel.app
TRUST_PROXY_HEADERS=false
RATE_LIMIT_ENABLED=true
ENABLE_ITVIEC_SCRAPER=false
ENABLE_TOPCV_SCRAPER=false
ENABLE_VIETNAMWORKS_SCRAPER=false
SCRAPER_CONTACT_EMAIL=you@example.com
ENABLE_SALARY_RETRAINING=false
DBT_TARGET=prod
DBT_HOST=POOLER_HOST
DBT_PORT=5432
DBT_USER=postgres.PROJECT_REF
DBT_PASSWORD=PASSWORD
DBT_DATABASE=postgres
MLFLOW_TRACKING_URI=sqlite:////app/artifacts/mlflow.db
SALARY_HOLDOUT_MANIFEST=data/salary_holdout_2026-07-19.json
# Set only on API after obtaining the ML service's internal Render address:
# SALARY_MODEL_URL=http://INTERNAL_ML_HOST:8002
# Set only on Vercel (root directory web, Node 24):
# API_INTERNAL_URL=https://YOUR_API.onrender.com
# PROXY_SHARED_SECRET=<same secret as Render, never NEXT_PUBLIC_*>
