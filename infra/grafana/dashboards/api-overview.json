{
  "title": "JobRadar API Overview",
  "uid": "jobradar-api",
  "schemaVersion": 41,
  "refresh": "15s",
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {"id": 1, "type": "timeseries", "title": "Request rate", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}, "targets": [{"expr": "sum(rate(jobradar_http_requests_total[5m]))", "legendFormat": "requests/s"}]},
    {"id": 2, "type": "timeseries", "title": "P95 latency", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(jobradar_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95"}]},
    {"id": 3, "type": "timeseries", "title": "HTTP errors", "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8}, "targets": [{"expr": "sum by (status) (rate(jobradar_http_requests_total{status=~\"4..|5..\"}[5m]))", "legendFormat": "{{status}}"}]}
  ]
}
