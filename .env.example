# Copy to .env for local development. Never commit a populated .env file.
# Managed production values are configured in Render, Vercel, and GitHub.

# Application
APP_ENV=development
SOURCE_REVISION=local
LOG_LEVEL=INFO
LOG_JSON=false

# PostgreSQL
# Runtime: use the Supabase transaction pooler (port 6543) in production.
DATABASE_URL=postgresql+asyncpg://jobradarvn:jobradarvn@localhost:5432/jobradarvn
# Migrations: use the direct connection or session pooler (port 5432).
MIGRATION_DATABASE_URL=
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_POOL_RECYCLE_SECONDS=300
DATABASE_STATEMENT_CACHE_SIZE=0

# Supabase Auth and Storage. SUPABASE_KEY is the public anon key, not the service key.
AUTH_MODE=local
SUPABASE_URL=
SUPABASE_KEY=
# Legacy backend alias; use this only when SUPABASE_KEY is not defined.
# SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional for legacy HS256 projects; new projects are verified through Supabase JWKS.
SUPABASE_JWT_SECRET=
# Server only. Never prefix this key with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=candidate-files
SUPABASE_JWT_AUDIENCE=authenticated

# Redis / Upstash. REDIS_URL should use rediss:// for hosted Upstash Redis.
REDIS_URL=redis://localhost:6379/0
# Optional REST transport for cache operations; the TCP URL remains the Celery broker.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CACHE_TTL_SECONDS=300

# Application secrets. Generate independent random values of at least 32 characters.
JWT_SECRET=
# Backward-compatible alias; uncomment only when JWT_SECRET is not defined.
# JWT_SECRET_KEY=
ADMIN_API_KEY=
CV_ENCRYPTION_KEY=
CRON_SECRET=
METRICS_TOKEN=

# Network and API behavior
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_JOBS_PER_PAGE=50
RATE_LIMIT_ENABLED=true
TRUST_PROXY_HEADERS=false

# Frontend. On Vercel both values should be the public Render API origin.
NEXT_PUBLIC_API_URL=http://localhost:8000
API_INTERNAL_URL=http://localhost:8000

# AI scoring. deterministic is local, reproducible, and free.
AI_PROVIDER=deterministic
AI_MODEL=jobradar-deterministic-v1
AI_FALLBACK_PROVIDERS=deterministic
AI_TOKEN_BUDGET=700
AI_REQUEST_TIMEOUT_SECONDS=20
AI_MAX_RETRIES=2
DAILY_RECOMMENDATION_USER_LIMIT=50
DAILY_RECOMMENDATION_JOB_LIMIT=50
DAILY_RECOMMENDATIONS_PER_USER=5
DAILY_RECOMMENDATION_MIN_SCORE=65
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Scrapers are opt-in. Respect each source's terms and robots policy.
SCRAPER_USER_AGENT=JobRadarVN-Research-Bot/1.0 (+https://jobradarvn.com/bot)
SCRAPER_CONTACT_EMAIL=bot@jobradarvn.com
ENABLE_ITVIEC_SCRAPER=false
ENABLE_TOPCV_SCRAPER=false
ENABLE_VIETNAMWORKS_SCRAPER=false
LINKEDIN_ACCESS_TOKEN=

# Notifications (optional)
TELEGRAM_BOT_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Analytics / model services (optional for the managed web/API path)
DBT_TARGET=dev
DBT_HOST=localhost
DBT_PORT=5432
DBT_USER=jobradarvn
DBT_PASSWORD=jobradarvn
DBT_DATABASE=jobradarvn
MLFLOW_TRACKING_URI=sqlite:///artifacts/mlflow.db
MLFLOW_EXPERIMENT=jobradar-salary
SALARY_MODEL_URL=
SALARY_HOLDOUT_MANIFEST=data/salary_holdout_2026-07-19.json
