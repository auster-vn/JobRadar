APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://jobradarvn:jobradarvn@localhost:5432/jobradarvn
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
ADMIN_API_KEY=replace-with-a-separate-admin-key
CV_ENCRYPTION_KEY=replace-with-a-separate-cv-encryption-key
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_JOBS_PER_PAGE=50
RATE_LIMIT_ENABLED=true
TRUST_PROXY_HEADERS=false
SCRAPER_USER_AGENT=JobRadarVN-Research-Bot/1.0 (+https://jobradarvn.com/bot)
SCRAPER_CONTACT_EMAIL=bot@jobradarvn.com
ENABLE_ITVIEC_SCRAPER=false
ENABLE_TOPCV_SCRAPER=false
ENABLE_VIETNAMWORKS_SCRAPER=false
LINKEDIN_ACCESS_TOKEN=
TELEGRAM_BOT_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MLFLOW_TRACKING_URI=file:artifacts/mlruns
MLFLOW_EXPERIMENT=jobradar-salary
SALARY_HOLDOUT_MANIFEST=data/salary_holdout_2026-07-19.json
